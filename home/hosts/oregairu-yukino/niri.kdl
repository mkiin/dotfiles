// oregairu-yukino: outputs and named (static) workspaces.

output "DP-1" {
	mode "1920x1080@60.000"
	position x=0 y=0
	scale 1.0
}

output "DP-2" {
	mode "2560x1440@180.000"
	position x=1920 y=0
	scale 1.0
}

output "DP-3" {
	mode "1920x1080@144.000"
	position x=4480 y=0
	scale 1.0
}

// Named workspaces "stick" to their output and never disappear when empty,
// approximating the previous static Hyprland workspace layout.
workspace "1" {
	open-on-output "DP-1"
}
workspace "2" {
	open-on-output "DP-1"
}
workspace "3" {
	open-on-output "DP-1"
}
workspace "4" {
	open-on-output "DP-2"
}
workspace "5" {
	open-on-output "DP-2"
}
workspace "6" {
	open-on-output "DP-2"
}
workspace "7" {
	open-on-output "DP-2"
}
workspace "8" {
	open-on-output "DP-3"
}
workspace "9" {
	open-on-output "DP-3"
}
workspace "0" {
	open-on-output "DP-3"
}

{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",

  "control-center-margin-top": 8,
  "control-center-margin-right": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-left": 8,
  "control-center-width": 320,
  "control-center-height": 660,

  "notification-window-width": 340,
  "notification-margin": 4,
  "notification-icon-size": 42,

  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,

  "fit-to-screen": false,
  "hide-on-clear": true,
  "hide-on-action": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,

  "widgets": [
    "title",
    "mpris",
    "volume",
    "buttons-grid",
    "dnd"
  ],

  "widget-config": {
    "title": {
      "text": "Notification Center",
      "clear-all-button": true,
      "button-text": "󰆴 Clear All"
    },

    "mpris": {
      "image-size": 96,
      "image-radius": 12,
      "show-album-art": "always",
      "autohide": true
    },

    "volume": {
      "label": "󰕾"
    },

    "buttons-grid": {
      "columns": 4,
      "actions": [
        {
          "label": "󰌾",
          "command": "hyprlock"
        },
        {
          "label": "󰗽",
          "command": "hyprshutdown --vt 2"
        },
        {
          "label": "󰐥",
          "command": "hyprshutdown --post-cmd 'systemctl poweroff'"
        },
        {
          "label": "󰜉",
          "command": "hyprshutdown --post-cmd 'systemctl reboot'"
        }
      ]
    }
  }
}

/* rofi global config */

configuration {
    show-icons:        false;
    hover-select:      true;
    me-select-entry:   "MouseSecondary";
    me-accept-entry:   "MousePrimary";
    /* kb-custom-1 と kb-move-char-back は dmenu.rasi 内に移動 (theme-scoped) */
}

/* @theme は設定しない: 各 script が -theme で明示する。
   ここで @theme するとそのテーマの configuration block が常に読まれて、
   他テーマ使用時にも kb-* が継承されてしまう */

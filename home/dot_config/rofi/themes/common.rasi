/* 共通の色・フォント変数 */
/* fallback ハードコード値 (matugen 未実行時用) → 末尾で colors-matugen.rasi が上書き */

* {
    background:        #1e1e2e;
    background-alt:    #313244;
    foreground:        #cdd6f4;
    selected:          #cba6f7;
    selected-fg:       #1e1e2e;
    active:            #a6e3a1;
    urgent:            #f38ba8;
    border-accent:     #89b4fa;

    font:              "JetBrains Mono Nerd Font 11";
}

@import "colors-matugen.rasi"

/**
 * 壁紙ピッカー (icon grid, polished)
 * - element カード風 (subtle bg + 角丸)
 * - 選択時 4px 強調 border + bg 変化
 * - ファイル名は小さく/薄く (主役はサムネ)
 */

@import "common.rasi"

configuration {
    show-icons: true;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       1240px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    cursor:                      "default";
    background-color:            transparent;
}

mainbox {
    enabled:                     true;
    spacing:                     16px;
    padding:                     20px;
    border:                      0px;
    border-radius:               18px;
    background-color:            @background;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     8px;
    padding:                     12px 16px;
    border-radius:               10px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @selected;
    font:                        "JetBrains Mono Nerd Font Bold 12";
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Search wallpapers...";
    placeholder-color:           @foreground;
}

listview {
    enabled:                     true;
    columns:                     4;
    lines:                       3;
    cycle:                       false;
    scrollbar:                   false;
    fixed-columns:               true;
    flow:                        horizontal;
    layout:                      vertical;
    spacing:                     14px;
    background-color:            transparent;
    cursor:                      "default";
}

element {
    enabled:                     true;
    expand:                      false;
    width:                       272px;
    spacing:                     8px;
    padding:                     10px;
    border:                      0px;
    border-radius:               14px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      pointer;
    orientation:                 vertical;
    children:                    [ "element-icon", "element-text" ];
}

element-icon {
    size:                        252px;
    background-color:            transparent;
    cursor:                      inherit;
    horizontal-align:            0.5;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    font:                        "JetBrains Mono Nerd Font 9";
}

element normal.normal,
element alternate.normal {
    background-color:            @background-alt;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-fg;
}

/**
 * 縦リスト系サブメニュー共通テーマ
 * 出典の構造: noro-dotfiles applets/type-1, Hyprland-Dots KooL_style-4
 * (Aditya Shakya @adi1090x, JaKooLit を参考に簡素化)
 */

@import "common.rasi"

configuration {
    /* dmenu (サブメニュー) のみで Left を Back にバインド、grid テーマには影響しない */
    kb-move-char-back: "Control+b";
    kb-custom-1:       "Left";
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       420px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    cursor:                      "default";
    background-color:            transparent;
}

mainbox {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     16px;
    border:                      0px;
    border-radius:               16px;
    background-color:            @background;
    children:                    [ "inputbar", "listview" ];
}

/* タイトル行 (script から -p で渡す文字列) + フィルタ/パスワード入力 entry */
inputbar {
    enabled:                     true;
    spacing:                     8px;
    padding:                     8px 12px;
    border:                      0px;
    border-radius:               8px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    padding:                     0px;
    background-color:            transparent;
    text-color:                  @selected;
    font:                        "JetBrains Mono Nerd Font Bold 12";
}

entry {
    enabled:                     true;
    padding:                     0px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "";
    placeholder-color:           @foreground;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       12;
    cycle:                       false;
    scrollbar:                   false;
    layout:                      vertical;
    spacing:                     4px;
    background-color:            transparent;
    cursor:                      "default";
}

element {
    enabled:                     true;
    padding:                     10px 14px;
    border:                      0px solid;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

element normal.normal,
element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}
element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-fg;
}
element normal.urgent,
element alternate.urgent,
element selected.urgent {
    background-color:            @urgent;
    text-color:                  @selected-fg;
}
element normal.active,
element alternate.active,
element selected.active {
    background-color:            @active;
    text-color:                  @selected-fg;
}

/**
 * アプリランチャ用テーマ (drun mode)
 * common.rasi の色変数を使用、entry (検索入力) が見える、icon 表示
 */

@import "common.rasi"

configuration {
    show-icons:        true;
    drun-display-format: "{name}";
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    cursor:                      "default";
    background-color:            transparent;
}

mainbox {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     16px;
    border:                      0px;
    border-radius:               16px;
    background-color:            @background;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     8px;
    padding:                     10px 14px;
    border:                      0px;
    border-radius:               8px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    padding:                     0px;
    background-color:            transparent;
    text-color:                  @selected;
    font:                        "JetBrains Mono Nerd Font Bold 12";
}

entry {
    enabled:                     true;
    padding:                     0px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Search apps...";
    placeholder-color:           @foreground;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       10;
    cycle:                       false;
    scrollbar:                   false;
    layout:                      vertical;
    spacing:                     4px;
    background-color:            transparent;
    cursor:                      "default";
}

element {
    enabled:                     true;
    spacing:                     12px;
    padding:                     8px 12px;
    border:                      0px solid;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element-icon {
    size:                        28px;
    background-color:            transparent;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

element normal.normal,
element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}
element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-fg;
}
element normal.urgent,
element alternate.urgent,
element selected.urgent {
    background-color:            @urgent;
    text-color:                  @selected-fg;
}
element normal.active,
element alternate.active,
element selected.active {
    background-color:            @active;
    text-color:                  @selected-fg;
}

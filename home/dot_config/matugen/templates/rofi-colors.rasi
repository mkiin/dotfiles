/* Generated by matugen - do not edit manually */
/* Updated on wallpaper change; consumed by rofi via themes/common.rasi */

* {
    background:        {{ colors.surface.default.hex }};
    background-alt:    {{ colors.surface_container_high.default.hex }};
    foreground:        {{ colors.on_surface.default.hex }};
    selected:          {{ colors.secondary.default.hex }};
    selected-fg:       {{ colors.on_secondary.default.hex }};
    active:            {{ colors.tertiary.default.hex }};
    urgent:            {{ colors.error.default.hex }};
    border-accent:     {{ colors.primary.default.hex }};
}

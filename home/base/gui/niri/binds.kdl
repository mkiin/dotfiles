// Common key bindings (the module injects these into the single `binds {}` node).

// Applications
Mod+T { spawn-sh "$TERMINAL"; }
Mod+E { spawn "nautilus"; }
Mod+B { spawn "zen-beta"; }
Mod+D { spawn "vesktop"; }

// Wallpaper
Mod+W { spawn-sh "noctalia msg wallpaper-next"; }
Mod+Shift+W { spawn-sh "noctalia msg panel-toggle wallpaper"; }

// Capture
Mod+Z { spawn-sh "noctalia msg screenshot-region"; }

// Window
Mod+C { close-window; }
Mod+V { toggle-window-floating; }
Mod+F { fullscreen-window; }
Mod+O { toggle-overview; }

// Noctalia
Mod+A { spawn-sh "noctalia msg panel-toggle launcher"; }
Mod+Space { spawn-sh "noctalia msg panel-toggle control-center"; }
Mod+S { spawn-sh "noctalia msg settings-toggle"; }
Mod+Q { spawn-sh "noctalia msg panel-toggle session"; }
Alt+Tab { spawn-sh "noctalia msg window-switcher hold"; }

// Focus
Mod+H { focus-column-left; }
Mod+J { focus-window-or-workspace-down; }
Mod+K { focus-window-or-workspace-up; }
Mod+L { focus-column-right; }

// Move
Mod+Shift+H { move-column-left; }
Mod+Shift+J { move-window-down-or-to-workspace-down; }
Mod+Shift+K { move-window-up-or-to-workspace-up; }
Mod+Shift+L { move-column-right; }

// Consume / Expel
Mod+BracketLeft { consume-or-expel-window-left; }
Mod+BracketRight { consume-or-expel-window-right; }

// Monitor focus
Mod+U { focus-monitor-left; }
Mod+I { focus-monitor-right; }

// Resize
Mod+Minus { set-column-width "-10%"; }
Mod+Equal { set-column-width "+10%"; }
Mod+Shift+Minus { set-window-height "-10%"; }
Mod+Shift+Equal { set-window-height "+10%"; }

Mod+Shift+Slash { show-hotkey-overlay; }

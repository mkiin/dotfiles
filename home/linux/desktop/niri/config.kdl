// niri configuration (managed by Home Manager)
// https://niri-wm.github.io/niri/Configuration:-Introduction

// Noctalia shell (started with spawn-at-startup per noctalia-dev docs,
// because the systemd user service is disabled).
spawn-at-startup "noctalia"

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

environment {
	QT_QPA_PLATFORM "wayland"
	QT_AUTO_SCREEN_SCALE_FACTOR "1"
	QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
	ELECTRON_OZONE_PLATFORM_HINT "auto"
	NIXOS_OZONE_WL "1"
	MOZ_ENABLE_WAYLAND "1"
	SDL_VIDEODRIVER "wayland"
}

input {
	keyboard {
		xkb {
			layout "us"
			options "caps:none"
		}
		repeat-delay 250
		repeat-rate 40
		numlock
	}
	mouse {
		accel-profile "flat"
		scroll-factor 2.0
	}
	touchpad {
		tap
	}
}

layout {
	gaps 10
	default-column-width { proportion 0.5; }
	focus-ring {
		off
	}
	border {
		off
	}
	shadow {
		on
		softness 30
		spread 5
		offset x=0 y=5
		color "#000000ee"
	}
}

blur {
	passes 2
	offset 3.0
	noise 0.01
	saturation 1.5
}

hotkey-overlay {
	skip-at-startup
}

// Noctalia notifications / window activation.
debug {
	honor-xdg-activation-with-invalid-serial
}

// Rounded corners for a modern look.
window-rule {
	background-effect {
		blur true
		xray false
	}
	geometry-corner-radius 20
	clip-to-geometry true
}

// Floating Noctalia settings window.
window-rule {
	match app-id="dev.noctalia.Noctalia"
	open-floating true
	default-column-width { fixed 1080; }
	default-window-height { fixed 920; }
}

window-rule {
	match app-id=r#"^org\.gnome\.Nautilus$"#
	open-floating true
	default-column-width { proportion 0.4; }
}

window-rule {
	match app-id="^mpv$"
	open-floating true
	default-column-width { fixed 800; }
	default-window-height { fixed 600; }
}

window-rule {
	match app-id="^imv$"
	open-floating true
	default-column-width { fixed 800; }
	default-window-height { fixed 600; }
}

// Noctalia layer surfaces: disable xray so blur samples what is behind them.
layer-rule {
	match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
	background-effect {
		xray false
	}
}

layer-rule {
	match namespace="noctalia-window-switcher"
	background-effect {
		blur true
		xray false
	}
}

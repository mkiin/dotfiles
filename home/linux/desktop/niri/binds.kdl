// Common key bindings (the module injects these into the single `binds {}` node).

Mod+Shift+Slash { show-hotkey-overlay; }
Mod+Shift+E { quit; }

// Applications
Mod+G { spawn "ghostty"; }
Mod+E { spawn "nautilus"; }
Mod+B { spawn "zen-beta"; }
Mod+D { spawn "vesktop"; }

// Wallpaper
Mod+W { spawn-sh "noctalia msg wallpaper-next"; }
Mod+Shift+W { spawn-sh "noctalia msg panel-toggle wallpaper"; }

// Capture
Mod+Z { spawn-sh "noctalia msg screenshot-region"; }

// Window
Mod+C { close-window; }
Mod+V { toggle-window-floating; }
Mod+F { fullscreen-window; }

// Noctalia
Mod+A { spawn-sh "noctalia msg panel-toggle launcher"; }
Mod+Space { spawn-sh "noctalia msg panel-toggle control-center"; }
Mod+S { spawn-sh "noctalia msg settings-toggle"; }
Mod+Q { spawn-sh "noctalia msg panel-toggle session"; }
Alt+Tab { spawn-sh "noctalia msg window-switcher hold"; }
Mod+Shift+D { spawn-sh "noctalia msg dock-toggle"; }

// Focus
Mod+H { focus-column-left; }
Mod+J { focus-window-down; }
Mod+K { focus-window-up; }
Mod+L { focus-column-right; }
Mod+Left { focus-column-left; }
Mod+Down { focus-window-down; }
Mod+Up { focus-window-up; }
Mod+Right { focus-column-right; }

// Move window
Mod+Shift+H { move-column-left; }
Mod+Shift+J { move-window-down; }
Mod+Shift+K { move-window-up; }
Mod+Shift+L { move-column-right; }

// Resize
Mod+Ctrl+H { set-column-width "-10%"; }
Mod+Ctrl+L { set-column-width "+10%"; }
Mod+Ctrl+K { set-window-height "-10%"; }
Mod+Ctrl+J { set-window-height "+10%"; }

// Workspaces
Mod+I { focus-workspace-up; }
Mod+O { focus-workspace-down; }
Mod+Shift+I { move-window-to-workspace-up; }
Mod+Shift+O { move-window-to-workspace-down; }

Mod+WheelScrollUp { focus-workspace-up; }
Mod+WheelScrollDown { focus-workspace-down; }

Mod+1 { focus-workspace "1"; }
Mod+2 { focus-workspace "2"; }
Mod+3 { focus-workspace "3"; }
Mod+4 { focus-workspace "4"; }
Mod+5 { focus-workspace "5"; }
Mod+6 { focus-workspace "6"; }
Mod+7 { focus-workspace "7"; }
Mod+8 { focus-workspace "8"; }
Mod+9 { focus-workspace "9"; }
Mod+0 { focus-workspace "0"; }

Mod+Shift+1 { move-window-to-workspace "1"; }
Mod+Shift+2 { move-window-to-workspace "2"; }
Mod+Shift+3 { move-window-to-workspace "3"; }
Mod+Shift+4 { move-window-to-workspace "4"; }
Mod+Shift+5 { move-window-to-workspace "5"; }
Mod+Shift+6 { move-window-to-workspace "6"; }
Mod+Shift+7 { move-window-to-workspace "7"; }
Mod+Shift+8 { move-window-to-workspace "8"; }
Mod+Shift+9 { move-window-to-workspace "9"; }
Mod+Shift+0 { move-window-to-workspace "0"; }

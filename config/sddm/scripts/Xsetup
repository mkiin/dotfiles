#!/bin/sh
# SDDM X11 モニター配置設定
# Hyprland の monitors.conf と同じレイアウトを xrandr で再現する
# ログイン画面が映る位置は --primary を付けたモニター
#
# 物理配置: [DP-3] [DP-2] [DP-1] [HDMI-A-1]    ← Hyprland (Wayland) 名
#           [DP-4] [DP-2] [DP-0] [HDMI-0]      ← X11 名（NVIDIA proprietary）
#            1080p  1440p  1080p   1080p
#
# NVIDIA proprietary driver の X11 と Wayland では出力名が異なる。
# 出力名の確認は /var/log/sddm-xsetup.log の xrandr --query 結果を参照。
# 認識失敗時は `xrandr` のエラーは無視され、デフォルト配置で続行する。

LOG=/tmp/sddm-xsetup.log
{
    echo "=== $(date) ==="
    echo "--- xrandr --query ---"
    xrandr --query
    echo "--- applying layout ---"
    xrandr \
        --output DP-4   --mode 1920x1080 --pos 0x0 \
        --output DP-2   --mode 2560x1440 --pos 1920x0 --primary \
        --output DP-0   --mode 1920x1080 --pos 4480x0 \
        --output HDMI-0 --mode 1920x1080 --pos 6400x0
    echo "--- xrandr exit code: $? ---"
    echo "--- post-apply xrandr --query ---"
    xrandr --query
} >> "$LOG" 2>&1

# /tmp は SDDM の X セッション終了時にクリアされる可能性があるため、永続的な場所にもコピー
cp "$LOG" /var/log/sddm-xsetup.log 2>/dev/null || true

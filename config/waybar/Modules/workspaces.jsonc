{
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "1",
      "2": "2",
      "3": "3",
      "4": "4",
      "default": "*"
    },
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "ignore-workspaces": ["^1[1-3]$", "^2[1-3]$", "^3[1-3]$", "^4[1-3]$"],
    "persistent-workspaces": {
      "*": [1, 2, 3, 4]
    }
  },
  "hyprland/workspaces#sub": {
    "format": "{icon}",
    "format-icons": {
      "11": "A",
      "12": "B",
      "13": "C",
      "21": "A",
      "22": "B",
      "23": "C",
      "31": "A",
      "32": "B",
      "33": "C",
      "41": "A",
      "42": "B",
      "43": "C",
      "default": ""
    },
    "all-outputs": false,
    "on-click": "activate",
    "ignore-workspaces": ["^[1-4]$"]
  }
}
